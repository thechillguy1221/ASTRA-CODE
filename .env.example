# Required for production backend startup.
ASTRA_RUNTIME_ENV=development
ASTRA_API_PORT=4317
ASTRA_DATABASE_URL=
DATABASE_URL=
ASTRA_MODEL_GATEWAY_URL=
ASTRA_MODEL_GATEWAY_API_KEY=
ASTRA_RUNTIME_TOKEN_SECRET=
ASTRA_SECURE_COOKIES=0
ASTRA_PUBLIC_SITE_URL=
ASTRA_ALLOWED_ORIGINS=
ASTRA_RESEND_API_KEY=
ASTRA_RAZORPAY_KEY_ID=
ASTRA_RAZORPAY_KEY_SECRET=
ASTRA_RAZORPAY_WEBHOOK_SECRET=
ASTRA_EMAIL_FROM=
ASTRA_GOOGLE_CLIENT_ID=
ASTRA_GOOGLE_CLIENT_SECRET=
ASTRA_GOOGLE_REDIRECT_URI=
ASTRA_RELAY_SECRET=
ASTRA_SUPERADMIN_EMAIL=
ASTRA_SUPERADMIN_PASSWORD_HASH=

# Optional / feature-specific configuration.
VITE_ASTRA_PUBLIC_SITE_URL=
ASTRA_GOOGLE_DESKTOP_CALLBACK_URI=astra://auth/callback
ASTRA_RELAY_REQUIRE_TLS=1

# Test/certification-only configuration. These values must not control normal
# production model selection or grant development entitlements.
ASTRA_LIVE_TEST=0
ASTRA_LIVE_TEST_MODEL_ID=
ASTRA_POSTGRES_RESTORE_URL=
ASTRA_POSTGRES_CERTIFY=0
ASTRA_DEVELOPMENT_ENTITLEMENT=0
ASTRA_WEB_SEARCH_ENDPOINT=
ASTRA_WEB_SEARCH_API_KEY=
ASTRA_WEB_SEARCH_QUERY=official TypeScript documentation

# Removed/obsolete: ASTRA_MODEL_ID is intentionally absent. User-selected
# models are validated through Astra's server-side model registry.
